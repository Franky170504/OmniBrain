# Copy this file to .env, then replace the placeholder values with your own keys.
PROJECT_NAME=OmniBrain
PROJECT_VERSION=1.0.0
FAST_API_URL=http://127.0.0.1:8000

# Local Qdrant works with: docker compose up -d
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
COLLECTION_NAME=omnibrain_documents
QDRANT_SCORE_THRESHOLD=0.35
QDRANT_SEARCH_LIMIT=5

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Create a Groq key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_SUPERVISIOR_MODEL=llama-3.1-8b-instant
GROQ_GENERAL_MODEL=llama-3.1-8b-instant

# LangSmith is optional. Leave tracing false to run without it.
LANGSMITH_TRACKING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omnibrain-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

MAX_UPLOAD_SIZE_MB=25
