# OmniBrain environment example

# FastAPI
PROJECT_NAME=OmniBrain
PROJECT_VERSION=1.0
FAST_API_URL=http://localhost:8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=omnibrain
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
AUTH_JWT_SECRET=replace-with-a-random-256-bit-secret

# Database schema initialization (development only)
DATABASE_AUTO_INIT=false

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=omnibrain

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=1

# Groq
GROQ_API_KEY=
GROQ_MODEL=groq-2.0
GROQ_SUPERVISIOR_MODEL=groq-supervisor
GROQ_GENERAL_MODEL=groq-general

# LangSmith
LANGSMITH_TRACKING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omnibrain
LANGSMITH_ENDPOINT=http://localhost

# Upload
MAX_UPLOAD_SIZE_MB=10

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=omnibrain-docs
MINIO_SECURE=false
